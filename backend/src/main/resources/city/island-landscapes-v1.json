  "viewpoints": [
    {
      "id": "cloudmere-view",
      "name": "Cloudmere Lakeside",
      "district": "Highlands",
      "x": -172,
      "z": -399,
      "description": "A dry western shore above Silverstream. The lake drains through a rocky waterfall into the valley; the marked trail leads to the northern ridge and river footbridge."
    },
    {
      "id": "silverstream-falls",
      "name": "Silverstream Falls Lookout",
      "district": "Highlands",
      "x": -65,
      "z": -350,
      "description": "A safe eastern valley viewpoint overlooking Silverstream's waterfall. Its trail crosses the northern footbridge to join the lakeside trail. Water and steep cliff edges are inaccessible; follow the trails around them."
    },
    {
      "id": "moonwash-cove",
      "name": "Moonwash Cove",
      "district": "Western Coast",
      "x": -705,
      "z": -120,
      "description": "A sandy sheltered cove below the western forest. The forest path connects the beach to Fern Valley, the ridge and the headland trail."
    },
    {
      "id": "basalt-lookout",
      "name": "Basalt Headland Lookout",
      "district": "Western Coast",
      "x": -710,
      "z": 10,
      "description": "A dry inland ledge above the rocky headland and cove. Stay on the marked approach; the exposed coastal cliff edge is inaccessible."
    },
    {
      "id": "fern-valley",
      "name": "Fern Valley Rest",
      "district": "Western Woods",
      "x": -550,
      "z": -245,
      "description": "An open resting spot in the forested valley between the western ridge and foothills. Follow the continuous ridge trail to Cloudmere or the western coast."
    },
    {
      "id": "silverstream-estuary",
      "name": "Silverstream Estuary",
      "district": "Eastern Coast",
      "x": 204,
      "z": 134,
      "description": "A dry sandy shore beside Silverstream's sea outlet. The eastern bank trail connects to the valley and southern footbridges; river water is inaccessible."
    }
